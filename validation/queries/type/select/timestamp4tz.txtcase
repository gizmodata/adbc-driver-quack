// part: metadata

[tags]
sql-type-name = "TIMESTAMPTZ"
field-type-name = "TIMESTAMPTZ"
caveats = ["DuckDB returns TIMESTAMPTZ values at microsecond precision; additional fractional digits are discarded. See https://duckdb.org/docs/current/sql/data_types/timestamp."]

// part: setup_query

CREATE TABLE test_timestamptz (
    idx INTEGER,
    res TIMESTAMPTZ
);

INSERT INTO test_timestamptz (idx, res) VALUES (1, TIMESTAMP WITH TIME ZONE '2023-05-15 13:45:30.1234+00');
INSERT INTO test_timestamptz (idx, res) VALUES (2, TIMESTAMP WITH TIME ZONE '2000-01-01 00:00:00.2345+00');
INSERT INTO test_timestamptz (idx, res) VALUES (3, TIMESTAMP WITH TIME ZONE '1969-07-20 20:17:40.3456+00');
INSERT INTO test_timestamptz (idx, res) VALUES (4, TIMESTAMP WITH TIME ZONE '0001-01-01 00:00:00.0000+00');
INSERT INTO test_timestamptz (idx, res) VALUES (5, TIMESTAMP WITH TIME ZONE '9999-12-31 23:59:59.9999+00');
INSERT INTO test_timestamptz (idx, res) VALUES (6, NULL);
