// part: metadata

[tags]
sql-type-name = "TIMESTAMPTZ"
field-type-name = "TIMESTAMPTZ"
caveats = ["DuckDB returns TIMESTAMPTZ values at microsecond precision; additional fractional digits are discarded. See https://duckdb.org/docs/current/sql/data_types/timestamp."]
partial-support = true

// part: setup_query

CREATE TABLE test_timestamptz (
    idx INTEGER,
    res TIMESTAMPTZ
);

INSERT INTO test_timestamptz (idx, res) VALUES (1, TIMESTAMP WITH TIME ZONE '2023-05-15 13:45:30.12345678+00');
INSERT INTO test_timestamptz (idx, res) VALUES (2, TIMESTAMP WITH TIME ZONE '2000-01-01 00:00:00.23456789+00');
INSERT INTO test_timestamptz (idx, res) VALUES (3, TIMESTAMP WITH TIME ZONE '1969-07-20 20:17:40.34567890+00');
INSERT INTO test_timestamptz (idx, res) VALUES (4, TIMESTAMP WITH TIME ZONE '1677-09-21 00:12:43.15+00');
INSERT INTO test_timestamptz (idx, res) VALUES (5, TIMESTAMP WITH TIME ZONE '2262-04-11 23:47:16.85+00');
INSERT INTO test_timestamptz (idx, res) VALUES (6, NULL);

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tsu:UTC",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": 1684158330123456}
{"res": 946684800234567}
{"res": -14182939654322}
{"res": -9223372036850000}
{"res": 9223372036850000}
{"res": null}
