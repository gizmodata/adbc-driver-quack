// part: metadata

[tags]
caveats = ["DuckDB stores TIME at microsecond precision (TIME_NS for nanoseconds), so TIME(p) reads back as time64[us]."]

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "ttu",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": 0}
{"res": null}
{"res": 49531000000}
{"res": 45045000000}
{"res": 86399000000}
