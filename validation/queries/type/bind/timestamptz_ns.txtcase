// part: metadata

[tags]
caveats = ["DuckDB reserves the INT64 extremes of TIMESTAMP_NS as -infinity/infinity, so they are not bindable values. DuckDB's TIMESTAMP(9) WITH TIME ZONE is microsecond TIMESTAMPTZ; its nanosecond type is TIMESTAMPTZ_NS."]

// part: setup_query

CREATE TABLE test_timestamptz (
    idx INT,
    res TIMESTAMPTZ_NS,
    res2 TIMESTAMPTZ_NS
);

// part: bind

{"idx": 3, "res": 1684158330000000000, "res2": 1684158330000000000}
{"idx": 2, "res": 946684800000000000, "res2": 946684800000000000}
{"idx": 0, "res": null, "res2": null}

// part: expected

{"res": null, "res2": null}
{"res": 946684800000000000, "res2": 946684800000000000}
{"res": 1684158330000000000, "res2": 1684158330000000000}
